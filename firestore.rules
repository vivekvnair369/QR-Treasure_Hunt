rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper checks
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isTeam(teamId) {
      return request.auth != null && 
        request.auth.uid == teamId;
    }

    // Admins have read/write everywhere
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Admins profile check
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // Events rules
    match /events/{eventId} {
      allow read: if request.auth != null;
    }

    // Teams rules
    match /teams/{teamId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == teamId);
      allow update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == teamId && (
            // Case 1: Just incrementing hints_used
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hints_used']) 
            ||
            // Case 2: Advancing sequence (QR Scan validation)
            (get(/databases/$(database)/documents/events/active_event).data.status == 'running' ||
             get(/databases/$(database)/documents/events/active_event).data.status == 'qualifying' ||
             get(/databases/$(database)/documents/events/active_event).data.status == 'championship') &&
            !get(/databases/$(database)/documents/events/active_event).data.scans_locked &&
            resource.data.status != 'disqualified' &&
            resource.data.status != 'paused' &&
            (
              // Subcase 2a: Starting the event
              (resource.data.status == 'registered' || resource.data.status == 'checked_in' || resource.data.status == 'waiting') &&
              request.resource.data.status == 'active' &&
              request.resource.data.start_time == request.time &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'start_time'])
              ||
              // Subcase 2b: Advancing sequence
              resource.data.status == 'active' &&
              request.resource.data.status == 'active' &&
              request.resource.data.current_sequence == resource.data.current_sequence + 1 &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_sequence'])
              ||
              // Subcase 2c: Finishing
              resource.data.status == 'active' &&
              request.resource.data.status == 'finished' &&
              request.resource.data.finish_time == request.time &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finish_time'])
            )
          )
        )
      );
    }

    // Clues rules
    match /clues/{clueId} {
      allow read: if request.auth != null && (
        isAdmin() || (
          resource.data.route_id == get(/databases/$(database)/documents/teams/$(request.auth.uid)).data.route_id &&
          resource.data.sequence == get(/databases/$(database)/documents/teams/$(request.auth.uid)).data.current_sequence
        )
      );
    }

    // qrCodes rules
    match /qrCodes/{qrId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
    }

    // Routes rules
    match /routes/{routeId} {
      allow read: if request.auth != null;
    }

    // Leaderboard rules
    match /leaderboard/{teamId} {
      allow read: if request.auth != null && (isAdmin() || !get(/databases/$(database)/documents/events/active_event).data.leaderboard_hidden);
      allow write: if request.auth != null && request.auth.uid == teamId;
    }

    // scanLogs rules
    match /scanLogs/{logId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.team_id == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.team_id == request.auth.uid;
    }
    
    // auditLogs rules
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
