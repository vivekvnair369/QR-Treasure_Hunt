rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper checks
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isTeam(teamId) {
      return request.auth != null && 
        request.auth.uid == teamId;
    }

    // Admins have read/write everywhere
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Admins profile check
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // Events rules
    match /events/{eventId} {
      allow read: if request.auth != null;
    }

    // Teams rules
    match /teams/{teamId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == teamId);
      allow update: if isTeam(teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hints_used']);
    }

    // Clues rules
    match /clues/{clueId} {
      allow read: if request.auth != null && (
        isAdmin() || (
          resource.data.route_id == get(/databases/$(database)/documents/teams/$(request.auth.uid)).data.route_id &&
          resource.data.sequence == get(/databases/$(database)/documents/teams/$(request.auth.uid)).data.current_sequence
        )
      );
    }

    // Leaderboard rules
    match /leaderboard/{teamId} {
      allow read: if request.auth != null && (isAdmin() || !get(/databases/$(database)/documents/events/active_event).data.leaderboard_hidden);
    }

    // scanLogs rules
    match /scanLogs/{logId} {
      allow read: if request.auth != null && (
        isAdmin() || resource.data.team_id == request.auth.uid
      );
    }
    
    // auditLogs rules
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
